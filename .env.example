# ─────────────────────────────────────────────────────────────────────────────
# Nexus RPG Engine — environment variables
# Copy this file to .env and adjust values for your setup.
# docker-compose reads .env automatically; never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of the Ollama inference server.
# Inside Docker: use the service name (nexus-llm).
# Local dev (no Docker): use http://localhost:11434
OLLAMA_URL=http://nexus-llm:11434

# Ollama performance knobs (passed to the nexus-llm container).
# Keep OLLAMA_NUM_PARALLEL=1 for CPU-only homelab to avoid memory contention.
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1

# ── Data paths (inside the nexus-api container) ───────────────────────────────
# These paths are mounted via Docker volumes — do not change unless you
# also update the volumes section in docker-compose.yml.
WORLD_STATE_PATH=/data/world_state.json
LANCEDB_PATH=/data/lancedb
CHRONOS_PATH=/data/chronos
AXIOM_RULES_PATH=/data/axiom_rules.json

# ── Frontend ──────────────────────────────────────────────────────────────────
# The URL the browser uses to reach the API.
# Must be an address reachable from the user's machine, not the Docker network.
# For local homelab: http://<homelab-ip>:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API.
# For phone/homelab access, add the frontend origin, e.g.
# http://192.168.1.50:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
